# Wird als .htaccess in public/ gelegt (der spätere Docroot der Subdomain).
# /api/* -> Symfony-Frontcontroller; vorhandene Dateien direkt; sonst SPA (index.html).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # API + Symfony-Routen an den Frontcontroller
    RewriteRule ^api(/.*)?$ index.php [QSA,L]

    # Existierende Dateien (SPA-Assets, Bilder) direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Alles andere -> SPA-Einstieg (Vue-Router, History-Mode)
    RewriteRule ^ index.html [L]
</IfModule>

# Caching: index.html always revalidated so a deploy is picked up without a
# hard reload; Vite assets carry a content hash and can be cached for good.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# Sensible Dateien niemals ausliefern (Sicherheitsnetz)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
